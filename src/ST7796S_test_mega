void setup() {
  Serial.begin(115200);
  Serial.println("ST7796S graphics demo");

  display.init(320, 480, 0, 0, ST7796S_RGB);
  display.setRotation(rotate); // landscape
  display.fillScreen(DISPLAY_COL_BG);  // Clear screen
  show_init();
}

void loop() {

  if (timeCount < millis()) {
    timeCount = millis() + 1000;
    timeRun += 1; 
    show_time();
  }
  if (updateCount < millis()) {  
    updateCount = millis() + 2000;
    show_speed();
    show_inclination();
    show_heart();
    show_energy();
    show_distance();
  }
}

void print_aligned_deci(Adafruit_GFX &gfx, int value,
                   int16_t x, int16_t y) {
  float j = (float)(value)/10;                    
  String str = String(j,1);
  const uint8_t l = 50; 
  const uint8_t digit = 3; 
  uint16_t w = 0, h = 61;
  // quirk formatting
  if (value >= 100)
    w = l; 
  if (value >= 1000)
    w = 2 * l; 
  if (value >= 10000)
    w = 3 * l; 

  gfx.setTextColor(DISPLAY_COL_TEXT, DISPLAY_COL_BG);
  gfx.fillRect(x - (l * (digit - 2)), y - h+2, l * digit + 15, h, DISPLAY_COL_DIV);        
  gfx.setCursor(x - w, y);  
  gfx.println(str);
}

void print_aligned(Adafruit_GFX &gfx, unsigned long value, unsigned long valueOld,
                   int16_t x, int16_t y, uint8_t digit) {
  unsigned long valueTemp = value; 
  const uint8_t l = 27, h = 35; 
  uint16_t w = -l;
  
  // formatting
  if (((value / 10000) == (valueOld / 10000)) && ((value / 10000) > 0)) 
    valueTemp = value - (value / 10000) * 10000;
    
  if (((value / 1000) == (valueOld / 1000)) && ((value / 1000) > 0)) 
    valueTemp = value - (value / 1000) * 1000;
    
  if (((value / 100) == (valueOld / 100)) && ((value / 100) > 0)) 
    valueTemp = value - (value / 100) * 100;
    
  if (((value / 10) == (valueOld / 10)) && ((value / 10) > 0)) 
    valueTemp = value - (value / 10) * 10;

  if (valueTemp >= 10)
    w = 0; 
  if (valueTemp >= 100)
    w = l; 
  if (valueTemp >= 1000)
    w = 2 * l; 
  if (valueTemp >= 10000)
    w = 3 * l; 
  w-= 13;

  String str = String(valueTemp);

  if (value > valueOld)
    gfx.fillRect(x - w, y - h + 2, 2 * l + w + 13, h - 2, DISPLAY_COL_DIV);   
  else
    gfx.fillRect(x - ((l * (digit - 2))-10), y - h+2, l * digit + 5, h - 2, DISPLAY_COL_BG);        
       
  gfx.setCursor(x - w, y);  
  gfx.println(str);
}


void show_speed() {

  speedkmOld = speedkm; 
  speedkm+= 3; 
  if (speedkm > 250)
    speedkm = 0; 
  
  uint8_t w = 0;
  if (speedkm >= 100)
    w = 47; 
  String str = String((float)(speedkm)/10,1);
    
  display.setTextSize(1);
  display.setFont(&Open_Sans_Regular_80);

  if (((speedkm/100) % 10) != ((speedkmOld/100) % 10))
    display.fillRect(105 - 47, 190 - 59, 42, 60, DISPLAY_COL_DIV);
  if (((speedkm/10) % 10) != ((speedkmOld/10) % 10))
    display.fillRect(105 + 2, 190 - 59, 42, 60, DISPLAY_COL_DIV);
  if ((speedkm  % 10) != (speedkmOld % 10))
    display.fillRect(105 + 71, 190 - 59, 42, 60, DISPLAY_COL_DIV);

  display.setCursor(105 - w, 190);
  display.println(str); 
}

void show_inclination() {
  int mOld = m; 
  int mTemp; 

  m+= 1; 
  if (m > 29)
    m = 3; 

  if (((m / 10) == (mOld / 10)) && ((m / 10) > 0)) 
    mTemp = m - (m / 10) * 10;
  else
    mTemp = m;
 
  int8_t w = 0;
  if (mTemp >= 10)
    w = 50; 
  
