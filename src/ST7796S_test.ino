void setup() {
  Serial.begin(115200);
  Serial.println("ST7796S graphics demo");

  display.init(320, 480, 0, 0, ST7796S_RGB);
  display.setRotation(1); // landscape
  display.fillScreen(DISPLAY_COL_BG);  // Clear screen
  show_init();
}

void loop() {

  if (timeCount < millis()) {
    timeCount = millis() + 1000;
    timeRun += 1; 
    show_time();
  }
  show_speed();
  show_inclination();
  show_heart();
  show_energy();
  show_distance();
  delay(50);
}

